# Copy this file to .env.local and fill in real values from your Supabase
# project (Settings -> API). Never commit .env.local.

# Public — safe to expose to the browser. RLS policies protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only. Bypasses RLS. Used only in app/api/**/route.ts files.
# Settings -> API -> Project API keys -> service_role (click "Reveal").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
